# Track only source/pipeline/model-asset directories.
*

!.gitignore
!.gitattributes
!README.md
!requirements.txt

!docs/
!docs/**

!code/
!code/**

!pipeline/
!pipeline/**

!pipelines/
!pipelines/**

!smpl_models/
!smpl_models/**

!witwin/
!witwin/**

# Local runtime/cache artifacts inside tracked trees.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.cache/
**/.slangtorch_cache/
**/*.lock
**/*.bak
